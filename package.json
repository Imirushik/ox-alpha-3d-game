{
  "name": "ox-bmx-game",
  "private": true,
  "version": "1.0.0",
  "description": "A cel-shaded downhill BMX racing game built for the browser.",
  "keywords": [
    "bmx",
    "game",
    "threejs",
    "typescript",
    "vite"
  ],
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm run build",
    "capture": "node tools/capture.mjs",
    "record": "node tools/record-demo.mjs",
    "record:hd": "node tools/record-demo.mjs"
  },
  "dependencies": {
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@types/three": "^0.180.0",
    "ffmpeg-static": "^5.3.0",
    "playwright": "^1.62.1",
    "typescript": "^5.9.2",
    "vite": "^7.1.3"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
